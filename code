# main execution logic
# ----------------------------
def interactive_menu():
    print("Redlining Simulation (interactive)\n")
    print("1) Run a single interactive simulation")
    print("2) Run classroom simulation (batch, N students)")
    print("3) Exit")
    choice = input("Enter choice: ").strip()
    if choice == "1":
        s = simulate_single_student(student_id=1, verbose=True, seed=None, export_map=True, export_pdf=True)
        print("\n--- Final Summary ---")
        print(f"Identity: {s['identity']['race']}, {s['identity']['gender']}")
        print("Background:", s['identity']['blurb'])
        print("Final stats:", s['final'])
        # write a JSON summary
        with open(f"student_{s['id']}_summary.json", "w") as f:
            json.dump(s, f, indent=2)
        print(f"Saved JSON summary to student_{s['id']}_summary.json")
    elif choice == "2":
        try:
            n = int(input("How many students (e.g., 30)? ").strip())
        except ValueError:
            n = 30
        run_classroom_simulation(num_students=n, export_csv=True, export_pdf_per_student=False, export_map=False, seed=42)
    else:
        print("Goodbye.")

if __name__ == "__main__":
    interactive_menu()
