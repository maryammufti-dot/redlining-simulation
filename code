import random

# Step 1: Assign identities
identities = ["White", "Black", "Hispanic", "Other"]
students = []

num_students = int(input("Enter number of students to simulate: "))

for i in range(num_students):
    student = {
        "id": i+1,
        "identity": random.choice(identities),
        "wealth": 50,   # start wealth points
        "health": 50,   # start health points
        "education": 50 # start education points
    }
    students.append(student)

# Step 2: Define life events
def buy_home(student):
    if student["identity"] in ["Black", "Hispanic"]:
        student["wealth"] -= random.randint(5, 15)  # higher mortgage rates, harder loans
    else:
        student["wealth"] += random.randint(5, 15)  # easier loan approval

def college(student):
    if student["identity"] in ["Black", "Hispanic"]:
        student["education"] -= random.randint(5, 10)  # systemic barriers
    else:
        student["education"] += random.randint(5, 10)

def healthcare(student):
    if student["identity"] in ["Black", "Hispanic"]:
        student["health"] -= random.randint(5, 10)  # less access
    else:
        student["health"] += random.randint(5, 10)

def career(student):
    if student["identity"] in ["Black", "Hispanic"]:
        student["wealth"] += random.randint(0, 5)  # lower starting salary
    else:
        student["wealth"] += random.randint(5, 15)

# Step 3: Run simulation
events = [buy_home, college, healthcare, career]

for student in students:
    for event in events:
        event(student)

# Step 4: Print results
print("\n--- Simulation Results ---")
for student in students:
    print(f"Student {student['id']} ({student['identity']}):")
    print(f"  Wealth: {student['wealth']}")
    print(f"  Education: {student['education']}")
    print(f"  Health: {student['health']}\n")

# Optional: show average scores by identity
from collections import defaultdict

totals = defaultdict(lambda: {"wealth": 0, "education": 0, "health": 0, "count": 0})

for student in students:
    iden = student["identity"]
    totals[iden]["wealth"] += student["wealth"]
    totals[iden]["education"] += student["education"]
    totals[iden]["health"] += student["health"]
    totals[iden]["count"] += 1

print("--- Average Scores by Identity ---")
for iden, data in totals.items():
    print(f"{iden}:")
    print(f"  Wealth: {data['wealth']/data['count']:.1f}")
    print(f"  Education: {data['education']/data['count']:.1f}")
    print(f"  Health: {data['health']/data['count']:.1f}\n")
