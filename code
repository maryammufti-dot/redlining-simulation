# Step 3: Determine outcome based on identity
def get_outcome(student_identity, choice):
    # White students are very likely to succeed
    if student_identity == "White":
        return "Success", 10, 10, 5
    else:
        # Other identities have a chance of denial/barrier
        chance = random.random()  # 0.0 to 1.0
        if chance < 0.5:  # 50% chance for denied/barrier
            return "Denied / Barrier encountered", 0, 0, -5
        elif chance < 0.8:  # 30% chance for partial success
            return "Partial success", 5, 5, 0
        else:  # 20% chance full success
            return "Success", 10, 10, 5

