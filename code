import random

# Step 1: Assign identity
identities = ["White", "Black", "Hispanic", "Other"]

# Step 2: Life events with identity-specific options
def get_life_event(student_identity):
    events = []

    # Housing event
    if student_identity == "White":
        events.append({
            "event": "You want to buy a house in your neighborhood.",
            "choices": ["Approved mortgage", "Rent instead", "Move to another area"]
        })
    else:
        # Black/Hispanic face barriers
        events.append({
            "event": "You want to buy a house in your neighborhood.",
            "choices": ["Mortgage denied", "High interest mortgage", "Rent instead"]
        })

    # College event
    if student_identity == "White":
        events.append({
            "event": "You want to go to college.",
            "choices": ["Scholarship awarded", "Community college", "Skip college"]
        })
    else:
        events.append({
            "event": "You want to go to college.",
            "choices": ["Scholarship denied", "Community college", "Skip college"]
        })

    # Healthcare event
    if student_identity == "White":
        events.append({
            "event": "You need healthcare for a minor illness.",
            "choices": ["Private clinic", "Community clinic", "Ignore symptoms"]
        })
    else:
        events.append({
            "event": "You need healthcare for a minor illness.",
            "choices": ["Long wait community clinic", "Free clinic", "Ignore symptoms"]
        })

    # Career event
    if student_identity == "White":
        events.append({
            "event": "You are offered a job opportunity.",
            "choices": ["High paying job", "Moderate paying job", "Start own business"]
        })
    else:
        events.append({
            "event": "You are offered a job opportunity.",
            "choices": ["Low paying job", "Moderate paying job", "Start own business"]
        })

    return random.choice(events)

# Step 3: Define outcome impacts
def apply_event(student, event):
    print(f"\nEVENT: {event['event']}")
    for i, choice in enumerate(event["choices"], 1):
        print(f"{i}. {choice}")

    while True:
        try:
            user_choice = int(input("Enter the number of your choice: "))
            if 1 <= user_choice <= len(event["choices"]):
                break
            else:
                print("Enter a valid number.")
        except ValueError:
            print("Enter a number.")

    choice = event["choices"][user_choice - 1]

    # Adjust outcomes based on choice and systemic barrier
    if "denied" in choice or "Long wait" in choice or "Low paying" in choice:
        student["wealth"] += 0
        student["education"] += 0
        student["health"] += -5
    elif "High interest" in choice or "Community college" in choice:
        student["wealth"] += 5
        student["education"] += 5
        student["health"] += 0
    else:
        student["wealth"] += 10
        student["education"] += 10
        student["health"] += 5

    print(f"Current Status → Wealth: {student['wealth']}, Education: {student['education']}, Health: {student['health']}")

# Step 4: Run simulation
def run_simulation():
    student = {
        "identity": random.choice(identities),
        "wealth": 50,
        "education": 50,
        "health": 50
    }

    print(f"Your assigned identity is: {student['identity']}")

    rounds = 5
    for _ in range(rounds):
        event = get_life_event(student["identity"])
        apply_event(student, event)

    # End of simulation
    print("\n--- Simulation Complete ---")
    print(f"Final outcomes for identity {student['identity']}:")
    print(f"Wealth: {student['wealth']}")
    print(f"Education: {student['education']}")
    print(f"Health: {student['health']}")
    print("\nReflection: The barriers and opportunities you faced during the simulation reflect systemic inequities associated with your identity.")

if __name__ == "__main__":
    run_simulation()
