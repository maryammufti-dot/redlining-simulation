import random

# Step 1: Assign identity
identities = ["White", "Black", "Hispanic", "Other"]

# Step 2: Life events with same choices for all
life_events = [
    {"event": "You want to buy a house in your neighborhood.", 
     "choices": ["Apply for mortgage", "Rent instead", "Move to another area"]},
    {"event": "You want to go to college.", 
     "choices": ["Apply for scholarships", "Attend community college", "Skip college"]},
    {"event": "You need healthcare for a minor illness.", 
     "choices": ["Go to private clinic", "Go to community clinic", "Ignore symptoms"]},
    {"event": "You are offered a job opportunity.", 
     "choices": ["Take high paying job", "Take moderate paying job", "Start own business"]},
    {"event": "You want to buy a car.", 
     "choices": ["Apply for auto loan", "Buy used car with cash", "Take public transportation"]},
    {"event": "You want to start a small business.", 
     "choices": ["Apply for business loan", "Self-fund business", "Wait and save money"]},
    {"event": "You face a medical emergency.", 
     "choices": ["Go to ER", "Visit urgent care", "Ignore symptoms"]},
    {"event": "You are up for a promotion.", 
     "choices": ["Promotion awarded", "Promotion delayed", "No promotion"]},
    {"event": "You need childcare for your child.", 
     "choices": ["Affordable high-quality childcare", "Moderate childcare", "Rely on family/friends"]},
    {"event": "You are concerned about neighborhood safety.", 
     "choices": ["Safe neighborhood", "Moderate safety", "Unsafe neighborhood"]},
]

# Step 3: Identity-specific outcomes
def get_outcome(student_identity, choice):
    # Mapping systemic barriers
    if student_identity == "White":
        # White faces no barriers
        return "Success", 10, 10, 5
    elif student_identity == "Black":
        # Black students face barriers
        if choice in ["Apply for mortgage", "Apply for scholarships", "Apply for auto loan", "Apply for business loan", "Promotion awarded"]:
            return "Denied / Barrier encountered", 0, 0, -5
        elif choice in ["Take high paying job", "Go to private clinic", "Affordable high-quality childcare", "Safe neighborhood"]:
            return "Partial success", 5, 5, 0
        else:
            return "Neutral outcome", 5, 5, 0
    elif student_identity == "Hispanic":
        # Hispanic students face moderate barriers
        if choice in ["Apply for mortgage", "Apply for scholarships", "Apply for auto loan", "Apply for business loan", "Promotion awarded"]:
            return "Denied / Barrier encountered", 0, 0, -3
        else:
            return "Neutral outcome", 5, 5, 0
    else:
        # Other identities face average outcomes
        return "Outcome varies", 5, 5, 0

# Step 4: Apply event
def apply_event(student, event):
    print(f"\nEVENT: {event['event']}")
    for idx, choice in enumerate(event["choices"], 1):
        print(f"{idx}. {choice}")

    while True:
        try:
            user_choice = int(input("Enter the number of your choice: "))
            if 1 <= user_choice <= len(event["choices"]):
                break
            else:
                print("Enter a valid number.")
        except ValueError:
            print("Enter a number.")

    choice = event["choices"][user_choice - 1]
    outcome_message, wealth_change, edu_change, health_change = get_outcome(student["identity"], choice)
    student["wealth"] += wealth_change
    student["education"] += edu_change
    student["health"] += health_change

    print(f"Your choice: {choice}")
    print(f"Outcome: {outcome_message}")
    print(f"Current Status → Wealth: {student['wealth']}, Education: {student['education']}, Health: {student['health']}")

# Step 5: Run simulation
def run_simulation():
    student = {
        "identity": random.choice(identities),
        "wealth": 50,
        "education": 50,
        "health": 50
    }

    print(f"Your assigned identity is: {student['identity']}")

    rounds = 10  # number of life events
    for i in range(rounds):
        event = random.choice(life_events)
        apply_event(student, event)

    # End summary
    print("\n--- Simulation Complete ---")
    print(f"Final outcomes for identity {student['identity']}:")
    print(f"Wealth: {student['wealth']}")
    print(f"Education: {student['education']}")
    print(f"Health: {student['health']}")
    print("\nReflection: Your outcomes were influenced by systemic barriers based on your assigned identity, showing how opportunities and obstacles accumulate over time.")

if __name__ == "__main__":
    run_simulation()
